#
#       The dungeon description file for Slash.
#
#	Note:	The order of the definition of dungeons in this file
#		reflects in their order of creation in the real dungeon.
#		The "Main" branch must *always* be first.
#

# [Tom] stretched out the Dungeons of Doom -- make it a little more
# interesting, and have more "normal" levels, because the special ones
# were more frequent than normal ones!

# Dungeon is from 42 to 47 levels deep...
DUNGEON:        "The Dungeons of Doom" "D" (42, 5)
ALIGNMENT:	unaligned

# Oracle is on levels 6 or 7
LEVEL:          "oracle" "O" @ (6, 2)
LEVALIGN:	neutral

# Quest is on levels 16-18 (I think) -- no special levels on these levels,
# or the quest may not be generated! doh!
CHAINBRANCH:    "The Quest" "oracle" + (10, 2) portal

# Mall 75% on levels 2 or 3
RNDLEVEL:       "mall" "T" @ (2, 2) 75 2
LEVALIGN:       lawful
LEVELDESC:      town

# Now all the branches... stretching all along the dungeon
# All are 66% to appear (see below...)
# Gnome mines around the oracle
BRANCH: 	"The Gnomish Mines" @ (6, 2)
# Orc & beholder caverns just before quest... (which is 16-18)
BRANCH: 	"The Orc Caverns" @ (9, 2)
BRANCH: 	"The Beholder Cave" @ (11, 2)
# Lost tomb just after
BRANCH: 	"The Lost Tomb" @ (19, 4)
# rounding out the bottom levels
BRANCH: 	"The Sunless Sea" @ (22, 2)
BRANCH: 	"The Spider Caves" @ (22, 4)
BRANCH: 	"The Temple of Moloch" @ (32, 4)
BRANCH: 	"The Giant Caverns" @ (32, 4)

# unused 'cause they suck
BRANCH: 	"The Wyrm Caves" @ (20, 2)
BRANCH: 	"One-eyed Sam's Market" @ (20, 2) portal

# Now the special levels...
# Remember, none on levels 16-18, or the Quest will likely disappear! Bad!
# Before quest, rats and kobolds are each 50%
LEVEL:          "rats" "R" @ (10, 2) 50
RNDLEVEL:       "kobold" "K" @ (14, 2) 50 2
# After quest, all the rest...
# Storage room (treasure) on levels 19-26, 66% of the time
RNDLEVEL:       "stor" "S" @ (19, 8) 66 3
RNDLEVEL:       "bigrm" "B" @ (20, 7) 15 7
LEVEL:          "nymph" "N" @ (23, 2) 45
# these next two levels are damn hard, so, make 'em low (above 38, that is)
LEVEL:          "guild" "G" @ (26, 6) 50
LEVEL:          "lich" "L" @ (34, 3) 15

# the famous Fort Ludios...
BRANCH:         "Fort Ludios" @ (23, 4) portal

# medusa can be as high as 38... nothing else below level 38!
RNDLEVEL:	"medusa" "none" @ (-5, 4) 2
LEVALIGN:	chaotic
LEVEL:		"castle" "none" @ (-1, 0)
CHAINBRANCH:	"Gehennom" "castle" + (0, 0) no_down
BRANCH:		"The Elemental Planes" @ (1, 0) no_down up

#
#	Gehennom
#
#	Now re-worked for 3.1  hell is hopefully going to be a little
#	less boring.  Also, in 3.1, the tower is not considered as a
#	part of hell, but is set up as a separate dungeon.
#
#	Gehennom is no longer considered "hellish" as a complete dungeon.
#	That is, fire resistance is no longer a condition for survival in
#	it.  However, Gehennom, and the special levels in it in particular,
#	is abundant with fire traps.  As a result, fire resistance is still
#	a prudent survival strategy in Gehennom.
#
#	Note:	Gehennom *must* be the second dungeon defined so that
#		monsters can properly migrate here under certain
#		circumstances.
#
# [Tom] tried to remove most of the non-unique levels (i.e. lame mazes)
# also tried to organize it a little -- demons before the wizard, devils
# after.

DUNGEON:        "Gehennom" "G" (17, 0)
DESCRIPTION:	mazelike
DESCRIPTION:	hellish
ALIGNMENT:	noalign
# tower before wiz, please
BRANCH:         "Vlad's Tower" @ (3, 10) up
LEVEL:		"valley" "V" @ (1, 0)
LEVEL:		"sanctum" "none" @ (-1, 0)
# the demon levels
LEVEL:          "juiblex" "J" @ (2, 5)
LEVEL:          "yeenoghu" "E" @ (2, 5)
LEVEL:          "orcus" "O" @ (2, 5)
LEVEL:          "demogorg" "D" @ (2, 5)
# half-way down
LEVEL:          "wizard1" "none" @ (7, 0)
CHAINLEVEL:	"wizard2" "X" "wizard1" + (1, 0)
CHAINLEVEL:	"wizard3" "Y" "wizard1" + (2, 0)
# the devil levels
LEVEL:          "baalz" "B" @ (10, 6)
LEVEL:          "geryon" "R" @ (10, 6)
LEVEL:          "dispater" "S" @ (10, 6)
LEVEL:          "asmodeus" "A" @ (10, 6)
LEVEL:          "fakewiz1" "F" @ (10, 6)
LEVEL:          "fakewiz2" "G" @ (10, 6)

#
#	The Mines of the Gnomes of Zurich.
#
DUNGEON:	"The Gnomish Mines" "M" (8, 2)
ALIGNMENT:	lawful
DESCRIPTION:	mazelike
LEVEL:          "minetown" "T" @ (3, 2)
LEVELDESC:	town
LEVEL:          "mine_end" "E" @ (-2, 0)
LEVEL:          "mineking" "M" @ (-1, 0)

#
#       The Orc Caverns.
#
DUNGEON:        "The Orc Caverns" "Z" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "cavefill" "Z" @ (1, 0)

#
#       The Spider Caves.
#
DUNGEON:        "The Spider Caves" "S" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "spiders" "S" @ (1, 0)

#
#       The Giant Caverns.
#
DUNGEON:        "The Giant Caverns" "H" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "cav2fill" "H" @ (1, 0)

#
#       The Beholder Cave.
#
DUNGEON:        "The Beholder Cave" "none" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "beholder" "none" @ (1, 0)

#
#       The Lost Tomb.
#
DUNGEON:        "The Lost Tomb" "L" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "tomb" "L" @ (1, 0)

#
#       The Black Market
#
DUNGEON:        "One-eyed Sam's Market" "D" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "blkmar" "D" @ (1, 0)

#
#       The Wyrm Caves.
#
DUNGEON:        "The Wyrm Caves" "D" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "dragons" "D" @ (1, 0)

#
#	The Questdungeon
#
#	This is a proto-dungeon.  The level file names will be prepended with
#	the first letter of the character name during initialization.
#	A special "x-fill" level must be defined in the levels description
#	file.  It will be used for all levels not defined explicitly below.
#
DUNGEON:	"The Quest" "Q" (5, 2)
LEVEL:	"x-start" "none" @ (1, 1)
LEVEL:	"x-locate" "L" @ (3, 1)
LEVEL:	"x-goal" "none" @ (-1, 0)

#
#	The Central Vault of Croesus.
#
DUNGEON:	"Fort Ludios" "K" (1, 0)
DESCRIPTION:	mazelike
ALIGNMENT:	unaligned
LEVEL:		"knox" "K" @ (-1, 0)

#
#	Vlad's Tower
#
#	It has been removed from Gehennom, and it is surrounded by stone.
#
DUNGEON:	"Vlad's Tower" "T" (3, 0)
PROTOFILE:	"tower"
DESCRIPTION:	mazelike
ALIGNMENT:	chaotic
ENTRY:		-1

#
#	The Endgame levels
#
DUNGEON:        "The Elemental Planes" "E" (5, 0)
DESCRIPTION:	mazelike
ALIGNMENT:	unaligned
ENTRY:          -1
LEVEL:		"astral" "none" @ (1, 0)
LEVEL:		"water"  "none" @ (2, 0)
LEVEL:		"fire"   "none" @ (3, 0)
LEVEL:		"air"    "none" @ (4, 0)
LEVEL:		"earth"  "none" @ (5, 0)

#
#       The Temple of Moloch.
#
DUNGEON:        "The Temple of Moloch" "none" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "mtemple" "none" @ (1, 0)

#
#       The Sunless Sea.
#
DUNGEON:        "The Sunless Sea" "none" (1, 0)
ALIGNMENT:      chaotic
DESCRIPTION:    mazelike
LEVEL:          "sea" "none" @ (1, 0)
